<h1>
    {% if mainTitleIcon %}
        <span class="hidden-xs material-icons-outlined">{{ mainTitleIcon }}</span>
    {% endif %}
    {{ title }}
    {% if subTitle %}
        <small id="subTitle">
            {% if subTitleIcon %}
                <span class="hidden-xs material-icons-outlined">{{ subTitleIcon }}</span>
            {% endif %}
            {{ subTitle }}
        </small>
    {% endif %}
</h1>
